# Copy to .env (git-ignored). Contains no secrets; tokens are mounted as files.
MIST_API_HOST=api.ac2.mist.com
MIST_ORG_ID=replace-with-org-uuid
KEEP_URL=http://127.0.0.1:8088

# Start in dry-run. Set to false only after reviewing the DRY_RUN log lines.
DRY_RUN=true

POLL_INTERVAL_S=60
# Mist types never sent to Keep (ARP failure/success was ~73% of alarm volume).
SUPPRESS_TYPES=infra_arp_failure,infra_arp_success,infra_dhcp_failure,infra_dhcp_success,infra_dns_failure,infra_dns_success
# Mist events with no recovery signal are posted, then resolved after this long.
AUTO_RESOLVE_MINUTES=30
# On an empty state DB: post alarms that are still open once, then continue normally.
BOOTSTRAP_POST_OPEN=true
# Mist alarms carry no reason for device_down. Fetch per-device events to find
# the actual disconnect reason (e.g. power loss, reboot). Bounded per cycle.
REASON_LOOKUP=true
REASON_LOOKUPS_PER_CYCLE=25
