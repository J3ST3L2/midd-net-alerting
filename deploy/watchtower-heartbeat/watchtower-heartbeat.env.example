# Copy to /etc/watchtower-heartbeat.env on Gravitron, chmod 600, owner root. Never commit the real file.
WATCHTOWER_URL=https://watchtower.middlebury.edu

# Same value as GRAVITRON_HEARTBEAT_TOKEN in /opt/stacks/midd-azure-monitoring/.env on Parachute.
HEARTBEAT_TOKEN=CHANGE_ME

# Cloudflare Access service token that lets the push past Access/challenge (see the Parachute repo's
# docs/gravitron-heartbeat.md). Leave both empty only if Cloudflare is not challenging this path.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional overrides
# KEEP_HEALTH_URL=http://127.0.0.1:8088/healthcheck
# ENDPOINT_KEY=10-monitoring_gravitron-heartbeat
