  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Campus network and Mist APs",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "nodes",
          "datasource": {
            "type": "mysql",
            "uid": "librenms-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- One node per LibreNMS location that has GPS coordinates.\n-- Anything you add/move in LibreNMS shows up here automatically.\nSELECT\n  CAST(l.id AS CHAR)                         AS id,\n  l.location                                 AS title,\n  CAST(l.lat AS DOUBLE)                      AS latitude,\n  CAST(l.lng AS DOUBLE)                      AS longitude,\n  COUNT(*)                                   AS switches,\n  SUM(d.status = 0)                          AS down,\n  COALESCE(GROUP_CONCAT(\n    CASE WHEN d.status = 0\n         THEN COALESCE(NULLIF(d.sysName, ''), d.hostname) END\n    ORDER BY d.hostname SEPARATOR ', '), '') AS down_devices\nFROM devices d\nJOIN locations l ON l.id = d.location_id\nWHERE d.disabled = 0\n  AND d.`ignore` = 0\n  AND d.type = 'network'\n  AND l.lat IS NOT NULL\n  AND l.lng IS NOT NULL\nGROUP BY l.id, l.location, l.lat, l.lng"
        },
        {
          "refId": "edges",
          "datasource": {
            "type": "mysql",
            "uid": "librenms-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- One edge per building pair, built from LLDP/CDP neighbours in the links table.\n-- Each physical link is seen from both ends, so collapse those first, then\n-- roll physical links (incl. LAG members) up to building-to-building edges.\nWITH seen AS (\n  SELECT\n    LEAST(dl.location_id, dr.location_id)    AS a,\n    GREATEST(dl.location_id, dr.location_id) AS b,\n    CASE WHEN k.remote_port_id IS NULL\n         THEN CONCAT('L', k.local_port_id)\n         ELSE CONCAT(LEAST(k.local_port_id, k.remote_port_id), '-',\n                     GREATEST(k.local_port_id, k.remote_port_id)) END AS phys,\n    (pl.ifOperStatus <> 'up')                AS is_down,\n    pl.ifHighSpeed                           AS mbps\n  FROM links k\n  JOIN devices dl ON dl.device_id = k.local_device_id\n  JOIN devices dr ON dr.device_id = k.remote_device_id\n  JOIN ports   pl ON pl.port_id   = k.local_port_id\n  JOIN locations la ON la.id = dl.location_id\n  JOIN locations lb ON lb.id = dr.location_id\n  WHERE k.active = 1\n    AND pl.deleted = 0\n    AND dl.disabled = 0 AND dl.`ignore` = 0 AND dl.type = 'network'\n    AND dr.disabled = 0 AND dr.`ignore` = 0 AND dr.type = 'network'\n    AND dl.location_id <> dr.location_id\n    AND la.lat IS NOT NULL AND lb.lat IS NOT NULL\n    -- AND pl.ifTrunk IS NOT NULL   -- uncomment to keep only 802.1Q trunk ports\n),\nphys AS (\n  SELECT a, b, phys, MAX(is_down) AS is_down, MAX(mbps) AS mbps\n  FROM seen\n  GROUP BY a, b, phys\n)\nSELECT\n  CONCAT(a, '-', b)          AS id,\n  CAST(a AS CHAR)            AS source,\n  CAST(b AS CHAR)            AS target,\n  COUNT(*)                   AS links,\n  SUM(is_down)               AS down_links,\n  ROUND(SUM(mbps) / 1000, 1) AS gbps\nFROM phys\nGROUP BY a, b"
        },
        {
          "refId": "aps",
          "datasource": {
            "type": "prometheus",
            "uid": "mist-prometheus"
          },
          "expr": "mist_site_aps",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "aps_down",
          "datasource": {
            "type": "prometheus",
            "uid": "mist-prometheus"
          },
          "expr": "(mist_site_aps - mist_site_aps_connected) > 0",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
