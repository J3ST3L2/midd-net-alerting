# Copy to .env (git-ignored). Contains no secrets; passwords are mounted as files from ./secrets.
# host:port of the LibreNMS MariaDB, reachable from the Grafana container.
LIBRENMS_DB_HOST=replace-with-db-host:3306
LIBRENMS_DB_NAME=librenms
LIBRENMS_DB_USER=grafana_ro

# Public URL users type; must match what the reverse proxy serves (nginx/librenms-grafana.conf). Trailing slash required.
GRAFANA_ROOT_URL=https://keep.middlebury.edu/netmap/
GRAFANA_PORT=3001
# Keep true behind HTTPS. Set false only for plain-HTTP testing against 127.0.0.1 (a Secure cookie is dropped over HTTP, which looks like being logged out on every click).
GRAFANA_COOKIE_SECURE=true
