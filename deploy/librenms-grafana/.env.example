# Copy to .env (git-ignored). Contains no secrets; passwords are mounted as files from ./secrets.
# host:port of the LibreNMS MariaDB (on raccoon), reachable from the Grafana container.
LIBRENMS_DB_HOST=raccoon.middlebury.edu:3306
LIBRENMS_DB_NAME=librenms
LIBRENMS_DB_USER=grafana_ro

# Public URL users type; must match what the reverse proxy serves. Trailing slash required.
GRAFANA_ROOT_URL=http://localhost:3001/
GRAFANA_PORT=3001
# Set to false only for plain-HTTP testing straight against 127.0.0.1.
GRAFANA_COOKIE_SECURE=true
