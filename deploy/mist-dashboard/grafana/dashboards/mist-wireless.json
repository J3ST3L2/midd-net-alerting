        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - mist_device_last_seen_timestamp_seconds) and on(mac) (mist_device_up{type=\"ap\",site=~\"$site\"} == 0)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Offline access points",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "mac": true,
              "type": true
            },
            "indexByName": {
              "AP": 0,
              "Down for": 3,
              "Model": 2,
              "Site": 1
            },
            "renameByName": {
              "Value": "Down for",
              "model": "Model",
              "name": "AP",
              "site": "Site"
            }
          }
        }
      ],
      "type": "table"
