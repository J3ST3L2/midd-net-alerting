          "instant": true,
          "legendFormat": "",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, type, model, mac) (mist_ap_clients{site=\"$site\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, type, model, mac) (mist_device_cpu_percent{site=\"$site\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, type, model, mac) (mist_device_memory_percent{site=\"$site\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, type, model, mac, version) (mist_device_info{site=\"$site\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "F"
        }
      ],
      "title": "Devices",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "mac": true
            },
            "indexByName": {
              "CPU": 5,
              "Clients": 4,
              "Device": 0,
              "Firmware": 8,
              "Memory": 6,
              "Model": 2,
              "Status": 3,
              "Type": 1,
              "Uptime": 7
            },
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "Uptime",
              "Value #C": "Clients",
              "Value #D": "CPU",
              "Value #E": "Memory",
              "model": "Model",
              "name": "Device",
              "type": "Type",
              "version": "Firmware"
            }
          }
        }
      ],
      "type": "table"
    },
