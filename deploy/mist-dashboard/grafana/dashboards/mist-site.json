    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every device at this site. Click a name to open it.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
