  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "PantherNet's share of unique clients on PantherNet + MiddleburyCollege, on Juniper Mist APs (24 h).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * mist_pn_unique_clients{ssid=\"PantherNet\"} / sum(mist_pn_unique_clients{ssid=~\"PantherNet|MiddleburyCollege\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "PantherNet share: Mist",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
