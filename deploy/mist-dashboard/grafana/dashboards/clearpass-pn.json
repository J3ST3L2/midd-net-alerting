      },
      "description": "Of the failing users old enough to judge, the percentage who signed in to MiddleburyCollege within 30 minutes of failing. Judged only after those 30 minutes, so it lags by that long. From ClearPass authentication records, which cover Mist and Aruba access points alike. The counts are blank until 24 hours of records have been received (ClearPass cannot replay history), so after an exporter restart the charts show a gap, not a false dip.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 4
