    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Unique users with at least one failed PantherNet sign-in in the last 24 hours, across the campus. From ClearPass authentication records, which cover Mist and Aruba access points alike. The counts are blank until 24 hours of records have been received (ClearPass cannot replay history), so after an exporter restart the charts show a gap, not a false dip.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "id": 5,
