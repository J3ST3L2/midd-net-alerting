{
  "annotations": {
    "list": []
  },
  "description": "PantherNet adoption across the whole campus from ClearPass, split by Aruba and Mist access points.",
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "mist"
      ],
      "title": "Mist dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Of the devices that signed in to PantherNet or MiddleburyCollege in the last 24 hours, the percentage on PantherNet, across every access point. From ClearPass authentication records, which cover Mist and Aruba access points alike. The counts are blank until 24 hours of records have been received (ClearPass cannot replay history), so after an exporter restart the charts show a gap, not a false dip.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * clearpass_pn_unique_clients{platform=\"campus\",ssid=\"PantherNet\"} / sum(clearpass_pn_unique_clients{platform=\"campus\",ssid=~\"PantherNet|MiddleburyCollege\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "PantherNet share: whole campus",
      "type": "stat"
    },
