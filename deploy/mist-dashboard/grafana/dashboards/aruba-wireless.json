          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "D"
        }
      ],
      "title": "Controllers",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Controller": 0,
              "Data age": 4,
              "Devices": 2,
              "Poll time": 3,
              "Reachable": 1
            },
            "renameByName": {
              "Value #A": "Reachable",
              "Value #B": "Devices",
              "Value #C": "Poll time",
              "Value #D": "Data age",
              "controller": "Controller"
            }
          }
        }
      ],
      "type": "table"
