    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Wireless devices connected to the Aruba controllers right now, all SSIDs. Counted from the Aruba controllers' own client tables every 2 minutes, one device per MAC. A controller that stops answering keeps its last count for 6 minutes, then drops out and shows as unreachable.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aruba_clients)",
          "format": "time_series",
