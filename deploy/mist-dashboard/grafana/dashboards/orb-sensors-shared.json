  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Orb sensors that have sent a score recently. A sensor that stops reporting drops out after 10 minutes. Each Orb sensor measures from the network edge and pushes its results every minute. Metric names are <dataset>_<field>, as Telegraf writes them.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "Waiting for Orb data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (orb_name) (scores_orb_score{orb_name=~\".*\"}))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Sensors reporting",
      "type": "stat"
    },
    {
      "datasource": {
