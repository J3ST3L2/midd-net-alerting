# Copy to .env (git-ignored). Contains no secrets; tokens are mounted as files from ./secrets.
MIST_API_HOST=api.ac2.mist.com
MIST_ORG_ID=replace-with-org-uuid

# Public URL users type. Grafana builds links and redirects from it, so it must match what
# the reverse proxy serves. A trailing slash is required.
GRAFANA_ROOT_URL=https://keep.middlebury.edu/mist-dashboard/
GRAFANA_PORT=3000
# Set to false only for plain-HTTP testing straight against 127.0.0.1:3000.
GRAFANA_COOKIE_SECURE=true

PROMETHEUS_RETENTION=180d

# PantherNet adoption panels (Mist Wireless dashboard). Optional; these are the defaults.
# Set FALLBACK_ENABLED=false to switch the whole feature off without a code change.
# FALLBACK_ENABLED=true
# A PantherNet failure counts as a fallback if MiddleburyCollege follows within this many seconds.
# FALLBACK_WINDOW_S=1800
# Mist calls per minute while the 24 h history loads: pages + lookups (steady state is a handful).
# FALLBACK_PAGES_PER_SLICE=16
# FALLBACK_LOOKUPS_PER_SLICE=24
# MiddleburyCollege event that means "connected" (confirm with clients/events/count before changing).
# MC_EVENT_TYPE=CLIENT_AUTH_ASSOCIATION

# Aruba side of PantherNet adoption: ClearPass pushes authentication records over syslog (see README,
# "Aruba / ClearPass"). Off by default. To enable, set all three, then `docker compose up -d`:
# CLEARPASS_SYSLOG_ENABLED=true
# CLEARPASS_ALLOW=192.0.2.10,192.0.2.11        # the ClearPass server address(es) that may send; required
# CLEARPASS_SYSLOG_BIND=192.0.2.50             # gravitron's address ClearPass sends to (default: loopback only)
# CLEARPASS_SYSLOG_HOST_PORT=5514
# Counts are withheld until this many hours of events have arrived (there is no history to backfill).
# CLEARPASS_MIN_HISTORY_H=24
# ClearPass error codes that should not count as PantherNet failures (comma separated), once known.
# CLEARPASS_NOISE_CODES=
