[Unit]
Description=SOLIDserver change log -> OpenObserve and Keep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/eip-tools.env
WorkingDirectory=/opt/midd-net-alerting/efficientip-tools
ExecStart=/usr/bin/python3 audit_feed.py
DynamicUser=yes
StateDirectory=eip-tools
Environment=EIP_AUDIT_STATE=/var/lib/eip-tools/audit.state.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TimeoutStartSec=120
