# /etc/eip-tools.env  (root:root, mode 0600). Copy this file, fill in the values, never commit the copy.

# SOLIDserver manager and a READ-ONLY API account (a dedicated one, not a person's login).
EIP_BASE_URL=https://solidserver-manager.example.org
EIP_USER=eip-readonly
EIP_PASS=
# 1 = verify the appliance certificate. Leave 0 until the internal CA is trusted on this host.
EIP_VERIFY_TLS=0

# --- audit_feed.py ---
# Keep event endpoint (the default is used when this line is absent).
# KEEP_URL=https://keep.example.org/backend/alerts/event
# OpenObserve stream that receives every event (optional; leave OO_URL empty to skip).
OO_URL=http://127.0.0.1:5080
OO_USER=
OO_PASS=
OO_STREAM=eip_audit
# More than this many identical changes by one account in a run become one summary card.
EIP_AUDIT_BURST=10
# Comma-separated accounts to drop entirely (ACME challenge records and reverse zones are always dropped).
EIP_AUDIT_IGNORE_USERS=

# --- vlan_inventory.py ---
EIP_VLAN_DOMAIN_IDS=2
CONFLUENCE_BASE_URL=https://example.atlassian.net
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PAGE_ID=
CONFLUENCE_PAGE_TITLE=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
